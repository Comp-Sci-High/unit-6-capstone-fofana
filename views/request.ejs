<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CS Match - Submit Resource</title>
       <link rel="stylesheet" href="request.css" />
  <script src="request.js" defer></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
    <!-- Icon imports -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css">
</head>
<body>
    <header>
        <div class="container header-container">
         <a href="/" class="logo">
  <svg viewBox="0 0 52 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Binary tree structure representing CS algorithms -->
    <circle cx="26" cy="8" r="3" fill="#00d4ff" opacity="0.9">
      <animate attributeName="opacity" values="0.6;1;0.6" dur="3s" repeatCount="indefinite"/>
    </circle>
    
    <!-- Left branch -->
    <line x1="26" y1="11" x2="16" y2="20" stroke="#7c4dff" stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="16" cy="22" r="2.5" fill="#7c4dff"/>
    
    <!-- Right branch -->
    <line x1="26" y1="11" x2="36" y2="20" stroke="#7c4dff" stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="36" cy="22" r="2.5" fill="#7c4dff"/>
    
    <!-- Connection paths showing matching -->
    <path d="M16 25 Q26 30 36 25" stroke="#ff6b9d" stroke-width="2" fill="none" stroke-linecap="round">
      <animate attributeName="stroke-dasharray" values="0 20;20 0;0 20" dur="4s" repeatCount="indefinite"/>
    </path>
    
    <!-- Lower nodes representing successful matches -->
    <circle cx="10" cy="36" r="2" fill="#00ff88">
      <animate attributeName="r" values="1.5;2.5;1.5" dur="2.5s" repeatCount="indefinite"/>
    </circle>
    <circle cx="22" cy="36" r="2" fill="#00ff88">
      <animate attributeName="r" values="1.5;2.5;1.5" dur="2.5s" repeatCount="indefinite" begin="0.5s"/>
    </circle>
    <circle cx="30" cy="36" r="2" fill="#00ff88">
      <animate attributeName="r" values="1.5;2.5;1.5" dur="2.5s" repeatCount="indefinite" begin="1s"/>
    </circle>
    <circle cx="42" cy="36" r="2" fill="#00ff88">
      <animate attributeName="r" values="1.5;2.5;1.5" dur="2.5s" repeatCount="indefinite" begin="1.5s"/>
    </circle>
    
    <!-- Connecting lines to matches -->
    <line x1="16" y1="25" x2="10" y2="34" stroke="#00ff88" stroke-width="1.5" opacity="0.7"/>
    <line x1="16" y1="25" x2="22" y2="34" stroke="#00ff88" stroke-width="1.5" opacity="0.7"/>
    <line x1="36" y1="25" x2="30" y2="34" stroke="#00ff88" stroke-width="1.5" opacity="0.7"/>
    <line x1="36" y1="25" x2="42" y2="34" stroke="#00ff88" stroke-width="1.5" opacity="0.7"/>
    
    <!-- Abstract code brackets -->
    <path d="M4 14 L8 14 L8 34 L4 34" stroke="#00d4ff" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.6"/>
    <path d="M48 14 L44 14 L44 34 L48 34" stroke="#00d4ff" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.6"/>
  </svg>
  CS Match
</a>
            <nav class="main-nav">
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/library">Resources</a></li>
                    <li><a href="/request">Submit</a></li>
                </ul>
            </nav>
             <div class="header-actions">
                <button class="btn btn-outline login-btn">Log In</button>
                <button class="mobile-menu-btn">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </div>
    </header>

       <div class="mobile-menu">
        <button class="close-btn">
            <i class="fas fa-times"></i>
        </button>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/library">Resources</a></li>
            <li><a href="/request">Submit</a></li>
        </ul>
    </div>

    <div class="submission-page">
        <div class="container">
          <h1>Submit a New Resource</h1>
<p>Help others find their perfect CS teaching match</p>

            <form id="resource-submission-form">
                <div class="form-section">
                    <h2>Basic Information</h2>
                    <div class="form-group">
                        <label for="product-name">Resource Name *</label>
                        <input type="text" id="product-name" name="productName" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="website-url">Website URL *</label>
                        <input type="url" id="website-url" name="website" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="description">Description *</label>
                        <textarea id="description" name="description" required></textarea>
                    </div>
                </div>
                
                <div class="form-section">
                    <!-- Resource Type Multi-Select -->
                    <div class="form-group">
                        <label for="resource-type">Resource Type *</label>
                        <div class="multi-select-container" id="resource-type-container">
                            <div class="selected-chips" id="resource-type-chips"></div>
                            <div class="input-container">
                                <input type="text" id="resource-type-input" class="multi-select-input" placeholder="Type to search resource types...">
                                <i class="fas fa-chevron-down dropdown-icon"></i>
                            </div>
                            <div class="dropdown-menu" id="resource-type-dropdown">
                                <div class="dropdown-item" data-value="Curriculum">Curriculum</div>
                                <div class="dropdown-item" data-value="Coding Platform">Coding Platform</div>
                                <div class="dropdown-item" data-value="Assessment Tool">Assessment Tool</div>
                                <div class="dropdown-item" data-value="Game/Activity">Game/Activity</div>
                                <div class="dropdown-item" data-value="Lesson Plans">Lesson Plans</div>
                                <div class="dropdown-item" data-value="Professional Development">Professional Development</div>
                                <div class="dropdown-item" data-value="Hardware/Robotics">Hardware/Robotics</div>
                                <div class="dropdown-item" data-value="Online Course">Online Course</div>
                                <div class="dropdown-item" data-value="Other">Other</div>
                            </div>
                        </div>
                        <div class="other-input" id="resource-type-other">
                            <input type="text" name="otherResourceType" placeholder="Please specify..." maxlength="100">
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="price-model">Price Model *</label>
                        <select id="price-model" name="priceModel" required>
                            <option value="">Select price model</option>
                            <option value="Free">Free</option>
                            <option value="Paid">Paid</option>
                            <option value="Freemium">Freemium</option>
                        </select>
                    </div>

                    <!-- Standards Alignment Multi-Select -->
                    <div class="form-group">
                        <label for="standard-alignment">Standards Alignment</label>
                        <div class="multi-select-container" id="standard-alignment-container">
                            <div class="selected-chips" id="standard-alignment-chips"></div>
                            <div class="input-container">
                                <input type="text" id="standard-alignment-input" class="multi-select-input" placeholder="Type to search standards...">
                                <i class="fas fa-chevron-down dropdown-icon"></i>
                            </div>
                            <div class="dropdown-menu" id="standard-alignment-dropdown">
                                <div class="dropdown-item" data-value="CSTA K–12 Computer Science Standards">CSTA K–12 Computer Science Standards</div>
                                <div class="dropdown-item" data-value="K–12 Computer Science Framework">K–12 Computer Science Framework</div>
                                <div class="dropdown-item" data-value="AP Computer Science Principles Framework">AP Computer Science Principles Framework</div>
                                <div class="dropdown-item" data-value="AP Computer Science A Framework">AP Computer Science A Framework</div>
                                <div class="dropdown-item" data-value="ISTE Standards for Students">ISTE Standards for Students</div>
                                <div class="dropdown-item" data-value="Next Generation Science Standards (NGSS)">Next Generation Science Standards (NGSS)</div>
                                <div class="dropdown-item" data-value="Other">Other</div>
                            </div>
                        </div>
                        <div class="other-input" id="standard-alignment-other">
                            <input type="text" name="otherStandardAlignment" placeholder="Please specify..." maxlength="100">
                        </div>
                    </div>

                    <!-- Grade Levels Multi-Select -->
                    <div class="form-group">
                        <label for="grade-level">Grade Levels *</label>
                        <div class="multi-select-container" id="grade-level-container">
                            <div class="selected-chips" id="grade-level-chips"></div>
                            <div class="input-container">
                                <input type="text" id="grade-level-input" class="multi-select-input" placeholder="Type to search grade levels...">
                                <i class="fas fa-chevron-down dropdown-icon"></i>
                            </div>
                            <div class="dropdown-menu" id="grade-level-dropdown">
                                <div class="dropdown-item" data-value="K-5">K-5</div>
                                <div class="dropdown-item" data-value="6-8">6-8</div>
                                <div class="dropdown-item" data-value="9-12">9-12</div>
                                <div class="dropdown-item" data-value="Higher Ed">Higher Ed</div>
                            </div>
                        </div>
                    </div>
                    
<div class="form-group">
    <label for="topics">Topics</label>
    <div class="multi-select-container" id="topics-container">
        <div class="selected-chips" id="topics-chips"></div>
        <div class="input-container">
            <input type="text" id="topics-input" class="multi-select-input" placeholder="Type to search topics...">
            <i class="fas fa-chevron-down dropdown-icon"></i>
        </div>
        <div class="dropdown-menu" id="topics-dropdown">
            <div class="dropdown-item" data-value="Software Engineering">Software Engineering</div>
            <div class="dropdown-item" data-value="Graphic/UX Design">Graphic/UX Design</div>
            <div class="dropdown-item" data-value="Cybersecurity">Cybersecurity</div>
            <div class="dropdown-item" data-value="Data Science">Data Science</div>
            <div class="dropdown-item" data-value="Robotics">Robotics</div>
            <div class="dropdown-item" data-value="Machine Learning/AI">Machine Learning/AI</div>
            <div class="dropdown-item" data-value="Other">Other</div>
        </div>
    </div>
    <div class="other-input" id="topics-other">
        <input type="text" name="otherTopics" placeholder="Please specify..." maxlength="100">
    </div>
</div>

                    <!-- Supported Languages Multi-Select -->
                    <div class="form-group">
                        <label for="languages">Supported Languages/Tools</label>
                        <div class="multi-select-container" id="languages-container">
                            <div class="selected-chips" id="languages-chips"></div>
                            <div class="input-container">
                                <input type="text" id="languages-input" class="multi-select-input" placeholder="Type to search languages/tools...">
                                <i class="fas fa-chevron-down dropdown-icon"></i>
                            </div>
                            <div class="dropdown-menu" id="languages-dropdown">
                                <div class="dropdown-item" data-value="Python">Python</div>
                                <div class="dropdown-item" data-value="Java">Java</div>
                                <div class="dropdown-item" data-value="JavaScript">JavaScript</div>
                                <div class="dropdown-item" data-value="C++">C++</div>
                                <div class="dropdown-item" data-value="C#">C#</div>
                                <div class="dropdown-item" data-value="Swift">Swift</div>
                                <div class="dropdown-item" data-value="Ruby">Ruby</div>
                                <div class="dropdown-item" data-value="Go">Go</div>
                                <div class="dropdown-item" data-value="HTML/CSS">HTML/CSS</div>
                                <div class="dropdown-item" data-value="SQL">SQL</div>
                                <div class="dropdown-item" data-value="R">R</div>
                                <div class="dropdown-item" data-value="Shell/Bash">Shell/Bash</div>
                                <div class="dropdown-item" data-value="PowerShell">PowerShell</div>
                                <div class="dropdown-item" data-value="Assembly">Assembly</div>
                                <div class="dropdown-item" data-value="C">C</div>
                                <div class="dropdown-item" data-value="Scratch">Scratch</div>
                                <div class="dropdown-item" data-value="Block-based">Block-based</div>
                                <div class="dropdown-item" data-value="Unplugged">Unplugged</div>
                                <div class="dropdown-item" data-value="AI Skills">AI Skills</div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" id="submit-btn">Submit Resource</button>
                    <button type="reset" class="btn btn-outline">Clear Form</button>
                </div>
            </form>
        </div>
    </div>

    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-about">
                    <a href="#" class="footer-logo">
    CS Match
</a>

                    <p>Our mission is to empower computer science educators with high-quality, vetted resources to enhance teaching and learning experiences.</p>
                   <p>Contact us: 📧 shilpa.agrawal@compscihigh.org</p>
            </div>
            <div class="footer-bottom">
<p>© 2025 CS Match. All rights reserved.</p>
                <p>Made with ❤️ for CS educators worldwide</p>
            </div>
        </div>
    </footer>

    <!-- Login Modal -->
    <div class="modal" id="login-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Log In</h3>
                <button class="modal-close">&times;</button>
            </div>
            <form id="login-form">
                <div class="form-group">
                    <label for="username" class="form-label">username</label>
                    <input type="text" id="username" name="username"class="form-input" required>
                </div>
                <div class="form-group">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" id="password" class="form-input" required>
                </div>
                <div class="form-footer">
                    <button type="submit" class="btn">Log In</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>