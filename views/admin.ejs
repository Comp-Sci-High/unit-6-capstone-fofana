<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CS Match Admin Portal</title>
    <link rel="stylesheet" href="admin.css" />
    <script src="admin.js" defer></script>
</head>
<body>
    <div class="admin-container">
        <header class="header">
            <div class="header-content">
                <h1>🛠 CS Match Admin Portal</h1>
                <button class="logout-btn" onclick="logout()">Logout</button>
            </div>
        </header>

        <main class="main-content">
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number" id="pendingCount">
                        <%= Requests.filter(req => req.isApproved === null || req.isApproved === undefined).length %>
                    </div>
                    <div class="stat-label">Pending Reviews</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number" id="approvedCount">
                        <%= Requests.filter(req => req.isApproved === true).length %>
                    </div>
                    <div class="stat-label">Approved Resources</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number" id="rejectedCount">
                        <%= Requests.filter(req => req.isApproved === false).length %>
                    </div>
                    <div class="stat-label">Rejected Submissions</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number" id="totalCount">
                        <%= Requests.length %>
                    </div>
                    <div class="stat-label">Total Submissions</div>
                </div>
            </div>

            <div class="submissions-section">
                <div class="section-header">
                    <h2 class="section-title">Resource Submissions</h2>
                    <div class="filter-tabs">
                        <button class="filter-tab active" onclick="filterSubmissions(event, 'all')">All</button>
                        <button class="filter-tab" onclick="filterSubmissions(event, 'pending')">Pending</button>
                        <button class="filter-tab" onclick="filterSubmissions(event, 'approved')">Approved</button>
                        <button class="filter-tab" onclick="filterSubmissions(event, 'rejected')">Rejected</button>
                    </div>
                </div>

                <div class="submissions-list" id="submissionsList">
                    <% if (Requests.length === 0) { %>
                        <div class="empty-state">
                            <h3>No submissions found</h3>
                            <p>There are no requests at the moment.</p>
                        </div>
                    <% } else { %>
                        <% for (let i = 0; i < Requests.length; i++) { %>
                            <% const Request = Requests[i]; %>
                            <div class="submission-card" data-status="<%= Request.isApproved === true ? 'approved' : Request.isApproved === false ? 'rejected' : 'pending' %>" data-request-id="<%= Request._id %>">
                                <div class="submission-header">
                                    <h3 class="submission-title"><%= Request.ProductName %></h3>
                                    <span class="status-badge <%= Request.isApproved === true ? 'status-approved' : Request.isApproved === false ? 'status-rejected' : 'status-pending' %>">
                                        <%= Request.isApproved === true ? 'Approved' : Request.isApproved === false ? 'Rejected' : 'Pending' %>
                                    </span>
                                </div>
                                
                                <p class="submission-description"><%= Request.Description %></p>
                                
                                <div class="submission-details">
                                    <div class="detail-item">
                                        <span class="detail-label">Website</span>
                                        <span class="detail-value">
                                            <a href="<%= Request.Website %>" target="_blank"><%= Request.Website %></a>
                                        </span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">Product Type</span>
                                        <span class="detail-value"><%= Request.ProductType %></span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">Price</span>
                                        <span class="detail-value"><%= Request.Price %></span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">Grade Level</span>
                                        <span class="detail-value"><%= Request.GradeLevel %></span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">Standard Alignment</span>
                                        <span class="detail-value"><%= Request.StandardAlignment || 'N/A' %></span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">Languages/Tools</span>
                                        <span class="detail-value"><%= Request.SupportedLanguages || 'N/A' %></span>
                                    </div>
                                </div>
                                
                                <% if (Request.isApproved === true) { %>
                                    <div class="edit-submission-form">
                                        <h4 class="edit-form-title">Edit Resource Details</h4>
                                        
                                        <div class="edit-form-grid">
                                            <div class="edit-form-group">
                                                <label for="edit-productname-<%= Request._id %>">Product Name *</label>
                                                <input type="text" id="edit-productname-<%= Request._id %>" value="<%= Request.ProductName %>" required>
                                            </div>
                                            
                                            <div class="edit-form-group">
                                                <label for="edit-website-<%= Request._id %>">Website URL *</label>
                                                <input type="url" id="edit-website-<%= Request._id %>" value="<%= Request.Website %>" required>
                                            </div>

                                            <div class="edit-form-group">
                                                <label for="edit-producttype-<%= Request._id %>">Resource Type *</label>
                                                <div class="multi-select-container" id="resourcetype-container-<%= Request._id %>">
                                                    <div class="multi-select-input">
                                                        <div class="selected-chips" id="resourcetype-chips-<%= Request._id %>"></div>
                                                        <input type="text" 
                                                               class="multi-select-search" 
                                                               id="resourcetype-search-<%= Request._id %>" 
                                                               placeholder="Search resource types..."
                                                               autocomplete="off">
                                                    </div>
                                                    <div class="multi-select-dropdown" id="resourcetype-dropdown-<%= Request._id %>">
                                                        <div class="dropdown-option" data-value="Curriculum">Curriculum</div>
                                                        <div class="dropdown-option" data-value="Coding Platform">Coding Platform</div>
                                                        <div class="dropdown-option" data-value="Assessment Tool">Assessment Tool</div>
                                                        <div class="dropdown-option" data-value="Game/Activity">Game/Activity</div>
                                                        <div class="dropdown-option" data-value="Lesson Plans">Lesson Plans</div>
                                                        <div class="dropdown-option" data-value="Professional Development">Professional Development</div>
                                                        <div class="dropdown-option" data-value="Hardware/Robotics">Hardware/Robotics</div>
                                                        <div class="dropdown-option" data-value="Online Course">Online Course</div>
                                                        <div class="dropdown-option" data-value="Other">Other</div>
                                                    </div>
                                                </div>
                                                <div class="other-input" id="other-producttype-<%= Request._id %>">
                                                    <input type="text" 
                                                           id="other-resourcetype-<%= Request._id %>" 
                                                           placeholder="Please specify other resource type..." 
                                                           maxlength="100">
                                                </div>
                                            </div>

                                            <div class="edit-form-group">
                                                <label for="edit-price-<%= Request._id %>">Price Model *</label>
                                                <select id="edit-price-<%= Request._id %>" required>
                                                    <option value="">Select price model</option>
                                                    <option value="Free" <%= Request.Price === 'Free' ? 'selected' : '' %>>Free</option>
                                                    <option value="Paid" <%= Request.Price === 'Paid' ? 'selected' : '' %>>Paid</option>
                                                    <option value="Freemium" <%= Request.Price === 'Freemium' ? 'selected' : '' %>>Freemium</option>
                                                </select>
                                            </div>

                                            <div class="edit-form-group">
                                                <label for="edit-gradelevel-<%= Request._id %>">Grade Levels *</label>
                                                <div class="multi-select-container" id="gradelevel-container-<%= Request._id %>">
                                                    <div class="multi-select-input">
                                                        <div class="selected-chips" id="gradelevel-chips-<%= Request._id %>"></div>
                                                        <input type="text" 
                                                               class="multi-select-search" 
                                                               id="gradelevel-search-<%= Request._id %>" 
                                                               placeholder="Search grade levels..."
                                                               autocomplete="off">
                                                    </div>
                                                    <div class="multi-select-dropdown" id="gradelevel-dropdown-<%= Request._id %>">
                                                        <div class="dropdown-option" data-value="K-5">K-5</div>
                                                        <div class="dropdown-option" data-value="6-8">6-8</div>
                                                        <div class="dropdown-option" data-value="9-12">9-12</div>
                                                        <div class="dropdown-option" data-value="Higher Ed">Higher Ed</div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="edit-form-group">
                                                <label for="edit-standardalignment-<%= Request._id %>">Standards Alignment</label>
                                                <div class="multi-select-container" id="standardalignment-container-<%= Request._id %>">
                                                    <div class="multi-select-input">
                                                        <div class="selected-chips" id="standardalignment-chips-<%= Request._id %>"></div>
                                                        <input type="text" 
                                                               class="multi-select-search" 
                                                               id="standardalignment-search-<%= Request._id %>" 
                                                               placeholder="Search standards alignment..."
                                                               autocomplete="off">
                                                    </div>
                                                    <div class="multi-select-dropdown" id="standardalignment-dropdown-<%= Request._id %>">
                                                        <div class="dropdown-option" data-value="CSTA K–12 Computer Science Standards">CSTA K–12 Computer Science Standards</div>
                                                        <div class="dropdown-option" data-value="K–12 Computer Science Framework">K–12 Computer Science Framework</div>
                                                        <div class="dropdown-option" data-value="AP Computer Science Principles Framework">AP Computer Science Principles Framework</div>
                                                        <div class="dropdown-option" data-value="AP Computer Science A Framework">AP Computer Science A Framework</div>
                                                        <div class="dropdown-option" data-value="ISTE Standards for Students">ISTE Standards for Students</div>
                                                        <div class="dropdown-option" data-value="Next Generation Science Standards (NGSS)">Next Generation Science Standards (NGSS)</div>
                                                        <div class="dropdown-option" data-value="Other">Other</div>
                                                    </div>
                                                </div>
                                                <div class="other-input" id="other-standards-<%= Request._id %>">
                                                    <input type="text" 
                                                           id="other-standardalignment-<%= Request._id %>" 
                                                           placeholder="Please specify other standards alignment..." 
                                                           maxlength="100">
                                                </div>
                                            </div>

                                            <div class="edit-form-group">
                                                <label for="edit-supportedlanguages-<%= Request._id %>">Supported Languages/Tools</label>
                                                <div class="multi-select-container" id="supportedlanguages-container-<%= Request._id %>">
                                                    <div class="multi-select-input">
                                                        <div class="selected-chips" id="supportedlanguages-chips-<%= Request._id %>"></div>
                                                        <input type="text" 
                                                               class="multi-select-search" 
                                                               id="supportedlanguages-search-<%= Request._id %>" 
                                                               placeholder="Search languages/tools..."
                                                               autocomplete="off">
                                                    </div>
                                                    <div class="multi-select-dropdown" id="supportedlanguages-dropdown-<%= Request._id %>">
                                                        <div class="dropdown-option" data-value="Python">Python</div>
                                                        <div class="dropdown-option" data-value="Java">Java</div>
                                                        <div class="dropdown-option" data-value="JavaScript">JavaScript</div>
                                                        <div class="dropdown-option" data-value="C++">C++</div>
                                                        <div class="dropdown-option" data-value="C#">C#</div>
                                                        <div class="dropdown-option" data-value="Swift">Swift</div>
                                                        <div class="dropdown-option" data-value="Ruby">Ruby</div>
                                                        <div class="dropdown-option" data-value="Go">Go</div>
                                                        <div class="dropdown-option" data-value="HTML/CSS">HTML/CSS</div>
                                                        <div class="dropdown-option" data-value="SQL">SQL</div>
                                                        <div class="dropdown-option" data-value="R">R</div>
                                                        <div class="dropdown-option" data-value="Shell/Bash">Shell/Bash</div>
                                                        <div class="dropdown-option" data-value="PowerShell">PowerShell</div>
                                                        <div class="dropdown-option" data-value="Assembly">Assembly</div>
                                                        <div class="dropdown-option" data-value="C">C</div>
                                                        <div class="dropdown-option" data-value="Scratch">Scratch</div>
                                                        <div class="dropdown-option" data-value="Block-based">Block-based</div>
                                                        <div class="dropdown-option" data-value="Unplugged">Unplugged</div>
                                                        <div class="dropdown-option" data-value="AI Skills">AI Skills</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="edit-form-group-full">
                                            <label for="edit-description-<%= Request._id %>">Description *</label>
                                            <textarea id="edit-description-<%= Request._id %>" rows="4" required><%= Request.Description %></textarea>
                                        </div>
                                        
                                        <div class="edit-form-actions">
                                            <button class="action-btn cancel-btn" onclick="cancelEditSubmission('<%= Request._id %>')">
                                                ❌ Cancel
                                            </button>
                                            <button class="action-btn save-btn" onclick="saveSubmissionEdit('<%= Request._id %>')">
                                                ✅ Save Changes
                                            </button>
                                        </div>
                                    </div>
                                <% } %>

                                <div class="submission-actions">
                                    <button class="action-btn view-btn" onclick="viewResource('<%= Request.Website %>')">
                                        🌐 View Resource
                                    </button>
                                    <button class="action-btn approve-btn" onclick="approveSubmission('<%= Request._id %>')">
                                        ✅ Approve
                                    </button>
                                    <button class="action-btn reject-btn" onclick="rejectSubmission('<%= Request._id %>')">
                                        ❌ Reject
                                    </button>
                                    <button class="action-btn delete-btn" onclick="deleteRequest('<%= Request._id %>')">
                                        🗑️ Delete
                                    </button>
                                    <% if (Request.isApproved === true) { %>
                                        <button class="action-btn edit-submission-btn" onclick="toggleEditSubmission('<%= Request._id %>')">
                                            ✏️ Edit Details
                                        </button>
                                        <button class="action-btn comments-btn" onclick="toggleComments('<%= Request._id %>')">
                                            💬 Manage Comments
                                        </button>
                                    <% } %>
                                </div>

                                <% if (Request.isApproved === true) { %>
                                    <div class="comments-section" id="comments-<%= Request._id %>">
                                        <div class="comments-header">
                                            <h4>Comments for <%= Request.ProductName %></h4>
                                            <div class="comments-stats">
                                                <span class="comment-count" id="comment-count-<%= Request._id %>">Loading...</span>
                                                <span class="average-rating" id="average-rating-<%= Request._id %>">Rating: Loading...</span>
                                            </div>
                                        </div>
                                        <div class="comments-list" id="comments-list-<%= Request._id %>">
                                            <div class="loading-comments">Loading comments...</div>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        <% } %>         
                    <% } %>
                </div>
            </div>
        </main>
    </div>
</body>
</html>