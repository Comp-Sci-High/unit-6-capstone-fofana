<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tool Details - CS Match</title>
    <link rel="stylesheet" href="indy.css" />
    <script src="indy.js" defer></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
    <!-- Icon imports -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css">
</head>
<body>
    <header class="header">
        <div class="nav-container">
            <a href="/" class="logo">
                <svg viewBox="0 0 52 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Binary tree structure representing CS algorithms -->
                    <circle cx="26" cy="8" r="3" fill="#00d4ff" opacity="0.9">
                        <animate attributeName="opacity" values="0.6;1;0.6" dur="3s" repeatCount="indefinite"/>
                    </circle>
                    
                    <!-- Left branch -->
                    <line x1="26" y1="11" x2="16" y2="20" stroke="#7c4dff" stroke-width="2.5" stroke-linecap="round"/>
                    <circle cx="16" cy="22" r="2.5" fill="#7c4dff"/>
                    
                    <!-- Right branch -->
                    <line x1="26" y1="11" x2="36" y2="20" stroke="#7c4dff" stroke-width="2.5" stroke-linecap="round"/>
                    <circle cx="36" cy="22" r="2.5" fill="#7c4dff"/>
                    
                    <!-- Connection paths showing matching -->
                    <path d="M16 25 Q26 30 36 25" stroke="#ff6b9d" stroke-width="2" fill="none" stroke-linecap="round">
                        <animate attributeName="stroke-dasharray" values="0 20;20 0;0 20" dur="4s" repeatCount="indefinite"/>
                    </path>
                    
                    <!-- Lower nodes representing successful matches -->
                    <circle cx="10" cy="36" r="2" fill="#00ff88">
                        <animate attributeName="r" values="1.5;2.5;1.5" dur="2.5s" repeatCount="indefinite"/>
                    </circle>
                    <circle cx="22" cy="36" r="2" fill="#00ff88">
                        <animate attributeName="r" values="1.5;2.5;1.5" dur="2.5s" repeatCount="indefinite" begin="0.5s"/>
                    </circle>
                    <circle cx="30" cy="36" r="2" fill="#00ff88">
                        <animate attributeName="r" values="1.5;2.5;1.5" dur="2.5s" repeatCount="indefinite" begin="1s"/>
                    </circle>
                    <circle cx="42" cy="36" r="2" fill="#00ff88">
                        <animate attributeName="r" values="1.5;2.5;1.5" dur="2.5s" repeatCount="indefinite" begin="1.5s"/>
                    </circle>
                    
                    <!-- Connecting lines to matches -->
                    <line x1="16" y1="25" x2="10" y2="34" stroke="#00ff88" stroke-width="1.5" opacity="0.7"/>
                    <line x1="16" y1="25" x2="22" y2="34" stroke="#00ff88" stroke-width="1.5" opacity="0.7"/>
                    <line x1="36" y1="25" x2="30" y2="34" stroke="#00ff88" stroke-width="1.5" opacity="0.7"/>
                    <line x1="36" y1="25" x2="42" y2="34" stroke="#00ff88" stroke-width="1.5" opacity="0.7"/>
                    
                    <!-- Abstract code brackets -->
                    <path d="M4 14 L8 14 L8 34 L4 34" stroke="#00d4ff" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.6"/>
                    <path d="M48 14 L44 14 L44 34 L48 34" stroke="#00d4ff" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.6"/>
                </svg>
                CS Match
            </a>
            <nav>
                <ul class="nav-links">
                    <li><a href="/">Home</a></li>
                    <li><a href="/library">Resources</a></li>
                    <li><a href="/request">Submit</a></li>
                </ul>
            </nav>
            <div class="header-actions">
                <button class="btn btn-outline login-btn">Log In</button>
                <button class="mobile-menu-btn">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </div>
    </header>

    <div class="container">
        <a href="/library" class="back-link">← Back to Resources</a>
        
        <% 
        // Find the current tool based on the URL parameter
        const currentTool = Requests.find(req => req._id.toString() === request.params.id);
        %>
        
        <% if (currentTool) { %>
        <div class="tool-header">
            <h1 class="tool-title"><%= currentTool.ProductName %></h1>
            <a href="<%= currentTool.Website %>" target="_blank" class="tool-website"><%= currentTool.Website %></a>
            
            <!-- Add Topic Display -->
            <div class="tool-topic">
                <span class="topic-label">Topic:</span>
                <span class="topic-value"><%= currentTool.Topic %></span>
            </div>
            
            <div class="tool-meta">
                <div class="meta-item">
                    <div class="meta-label">Resource Type</div>
                    <div class="meta-value"><%= currentTool.ProductType %></div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Price</div>
                    <div class="meta-value"><%= currentTool.Price %></div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Grade Level</div>
                    <div class="meta-value"><%= currentTool.GradeLevel %></div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Standards</div>
                    <div class="meta-value"><%= currentTool.StandardAlignment || 'Not specified' %></div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Languages</div>
                    <div class="meta-value"><%= currentTool.SupportedLanguages || 'Not specified' %></div>
                </div>
            </div>
        </div>

        <div class="tool-description">
            <h2 class="section-title">Description</h2>
            <p><%= currentTool.Description %></p>
        </div>

        <!-- Add Related Tools Section -->
        <div class="related-tools">
            <h2 class="section-title">Related Tools</h2>
            <div class="related-tools-grid">
                <% 
                // Find other tools with the same topic
                const relatedTools = Requests.filter(req => 
                    req.Topic === currentTool.Topic && 
                    req._id.toString() !== currentTool._id.toString() &&
                    req.isApproved === true
                ).slice(0, 3); // Limit to 3 related tools
                %>
                
                <% if (relatedTools.length > 0) { %>
                    <% relatedTools.forEach(tool => { %>
                    <div class="related-tool-card">
                        <h3 class="related-tool-name">
                            <a href="/indy/<%= tool._id %>"><%= tool.ProductName %></a>
                        </h3>
                        <p class="related-tool-type"><%= tool.ProductType %></p>
                        <p class="related-tool-price"><%= tool.Price %></p>
                    </div>
                    <% }); %>
                <% } else { %>
                    <p class="no-related-tools">No related tools found for this topic.</p>
                <% } %>
            </div>
        </div>

        <div class="comments-section">
            <h2 class="section-title">Reviews & Comments</h2>
            
            <div id="average-rating"></div>
            
            <div class="comment-form">
                <h3 style="margin-bottom: 1rem; color: #333;">Share Your Experience</h3>
                <div class="error-message" id="error-message"></div>
                <div class="success-message" id="success-message">Review submitted successfully!</div>
                
                <form id="comment-form">
                    <div class="form-group">
                        <label class="form-label">Your Name</label>
                        <input type="text" class="form-input" id="username" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Organization</label>
                        <input type="text" class="form-input" id="organization" placeholder="e.g., ABC Elementary School">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Role</label>
                        <input type="text" class="form-input" id="role" placeholder="e.g., Teacher, Administrator, Parent">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Rating</label>
                        <div class="rating-input">
                            <span class="star" onclick="setRating(1)">★</span>
                            <span class="star" onclick="setRating(2)">★</span>
                            <span class="star" onclick="setRating(3)">★</span>
                            <span class="star" onclick="setRating(4)">★</span>
                            <span class="star" onclick="setRating(5)">★</span>
                            <span style="margin-left: 1rem; color: #666;" id="rating-text">Click to rate</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Your Review</label>
                        <textarea class="form-textarea" id="comment" rows="4" placeholder="Share your thoughts about this tool..." required></textarea>
                    </div>
                    <button type="submit" class="btn-submit">Submit Review</button>
                </form>
            </div>

            <div id="comments-list">
                <% if (Comments && Comments.length > 0) { %>
                    <% Comments.forEach(comment => { %>
                    <div class="comment-item" data-comment-id="<%= comment._id %>" data-rating="<%= comment.rating %>">
                        <div class="comment-header">
                            <div class="comment-user-info">
                                <span class="comment-username"><%= comment.username %></span>
                                <% if (comment.organization || comment.role) { %>
                                    <span class="comment-details">
                                        <% if (comment.organization) { %><span class="comment-organization"><%= comment.organization %></span><% } %>
                                        <% if (comment.organization && comment.role) { %> • <% } %>
                                        <% if (comment.role) { %><span class="comment-role"><%= comment.role %></span><% } %>
                                    </span>
                                <% } %>
                                <span class="comment-date-full">
                                    <span class="date-part"><%= new Date(comment.createdAt || comment.timestamp || Date.now()).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                                    <span class="time-part"><%= new Date(comment.createdAt || comment.timestamp || Date.now()).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %></span>
                                </span>
                            </div>
                            <div class="comment-rating">
                                <% for(let i = 0; i < comment.rating; i++) { %>
                                    <span class="comment-star">★</span>
                                <% } %>
                            </div>
                        </div>
                        <div class="comment-content">
                            <div class="comment-text"><%= comment.comment %></div>
                        </div>
                    </div>
                    <% }); %>
                <% } else { %>
                    <div class="no-comments">No reviews yet. Be the first to share your experience!</div>
                <% } %>
            </div>
        </div>
        <% } else { %>
        <div class="tool-header">
            <h1 class="tool-title">Tool Not Found</h1>
            <p>Sorry, the requested tool could not be found.</p>
        </div>
        <% } %>
    </div>

    <!-- Login Modal -->
    <div class="modal" id="login-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Log In</h3>
                <button class="modal-close">&times;</button>
            </div>
            <form id="login-form">
                <div class="form-group">
                    <label for="login-username" class="form-label">Username</label>
                    <input type="text" id="login-username" name="username" class="form-input" required>
                </div>
                <div class="form-group">
                    <label for="login-password" class="form-label">Password</label>
                    <input type="password" id="login-password" name="password" class="form-input" required>
                </div>
                <div class="error-message" id="login-error-message" style="display: none;"></div>
                <div class="form-footer">
                    <button type="submit" class="btn">Log In</button>
                </div>
            </form>
        </div>
    </div>

    <style>
     /* Modern Topic Display Styles */
.tool-topic {
    margin: 1.5rem 0;
    position: relative;
    overflow: hidden;
}

/* Style 1: Pill Badge Design */
.topic-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.2rem;
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    border-radius: 50px;
    color: white;
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
    position: relative;
    overflow: hidden;
}

.topic-pill::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: left 0.5s ease;
}

.topic-pill:hover::before {
    left: 100%;
}

.topic-pill:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
}

.topic-pill .topic-icon {
    font-size: 1rem;
    opacity: 0.9;
}

/* Style 2: Card-Style Topic */
.topic-card {
    background: white;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: var(--shadow-md);
    border-left: 6px solid var(--primary);
    transition: var(--transition);
    position: relative;
}

.topic-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
}

.topic-card::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    border-radius: 0 16px 0 100%;
    opacity: 0.1;
}

.topic-card .topic-label {
    font-size: 0.8rem;
    color: var(--gray);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.5rem;
    font-weight: 500;
}

.topic-card .topic-value {
    font-size: 1.2rem;
    color: var(--dark);
    font-weight: 700;
    font-family: var(--font-secondary);
}

/* Style 3: Minimal Tag Design */
.topic-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    background: rgba(233, 30, 99, 0.1);
    border: 2px solid var(--primary);
    border-radius: 8px;
    color: var(--primary);
    font-weight: 600;
    font-size: 0.9rem;
    transition: var(--transition);
}

.topic-tag:hover {
    background: var(--primary);
    color: white;
    transform: scale(1.05);
}

.topic-tag .topic-hashtag {
    font-weight: 300;
    opacity: 0.7;
}

/* Style 4: Glassmorphism Effect */
.topic-glass {
    background: rgba(233, 30, 99, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(233, 30, 99, 0.2);
    border-radius: 20px;
    padding: 1rem 1.5rem;
    position: relative;
    overflow: hidden;
}

.topic-glass::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(233, 30, 99, 0.5), transparent);
}

.topic-glass .topic-content {
    position: relative;
    z-index: 1;
}

.topic-glass .topic-label {
    color: var(--primary);
    font-weight: 500;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.25rem;
}

.topic-glass .topic-value {
    color: var(--dark);
    font-weight: 600;
    font-size: 1.1rem;
}

/* Alternative single-color version that matches your primary brand color */
.tool-topic.single-color {
    background: var(--primary);
    border: 2px solid var(--primary-dark);
}

/* Light theme version for better contrast */
.tool-topic.light {
    background: rgba(233, 30, 99, 0.1);
    border: 2px solid var(--primary);
}

.tool-topic.light .topic-label {
    color: var(--primary);
}

.tool-topic.light .topic-value {
    color: var(--dark);
    text-shadow: none;
}

/* Match with other elements that use the same color scheme */
.topic-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--primary);
    color: white;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 500;
    margin: 0.5rem 0;
}

.topic-badge::before {
    content: "📚";
    font-size: 0.9rem;
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .tool-topic {
        padding: 0.5rem 1rem;
        margin: 0.75rem 0;
    }
    
    .topic-label {
        font-size: 0.8rem;
    }
    
    .topic-value {
        font-size: 0.9rem;
    }
}

    </style>

</body>
</html>