<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CS Match - Resource Library</title>
    <link rel="stylesheet" href="library.css" />
    <link rel="stylesheet" href="autocomplete-multiselect.css" />
    <script src="library.js" defer></script>
    <script src="autocomplete-multiselect.js" defer></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
    <!-- Icon imports -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css">
</head>
<body>
    <header>
        <div class="container header-container">
            <a href="/" class="logo">
                <svg viewBox="0 0 52 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Binary tree structure representing CS algorithms -->
                    <circle cx="26" cy="8" r="3" fill="#00d4ff" opacity="0.9">
                        <animate attributeName="opacity" values="0.6;1;0.6" dur="3s" repeatCount="indefinite"/>
                    </circle>
                    
                    <!-- Left branch -->
                    <line x1="26" y1="11" x2="16" y2="20" stroke="#7c4dff" stroke-width="2.5" stroke-linecap="round"/>
                    <circle cx="16" cy="22" r="2.5" fill="#7c4dff"/>
                    
                    <!-- Right branch -->
                    <line x1="26" y1="11" x2="36" y2="20" stroke="#7c4dff" stroke-width="2.5" stroke-linecap="round"/>
                    <circle cx="36" cy="22" r="2.5" fill="#7c4dff"/>
                    
                    <!-- Connection paths showing matching -->
                    <path d="M16 25 Q26 30 36 25" stroke="#ff6b9d" stroke-width="2" fill="none" stroke-linecap="round">
                        <animate attributeName="stroke-dasharray" values="0 20;20 0;0 20" dur="4s" repeatCount="indefinite"/>
                    </path>
                    
                    <!-- Lower nodes representing successful matches -->
                    <circle cx="10" cy="36" r="2" fill="#00ff88">
                        <animate attributeName="r" values="1.5;2.5;1.5" dur="2.5s" repeatCount="indefinite"/>
                    </circle>
                    <circle cx="22" cy="36" r="2" fill="#00ff88">
                        <animate attributeName="r" values="1.5;2.5;1.5" dur="2.5s" repeatCount="indefinite" begin="0.5s"/>
                    </circle>
                    <circle cx="30" cy="36" r="2" fill="#00ff88">
                        <animate attributeName="r" values="1.5;2.5;1.5" dur="2.5s" repeatCount="indefinite" begin="1s"/>
                    </circle>
                    <circle cx="42" cy="36" r="2" fill="#00ff88">
                        <animate attributeName="r" values="1.5;2.5;1.5" dur="2.5s" repeatCount="indefinite" begin="1.5s"/>
                    </circle>
                    
                    <!-- Connecting lines to matches -->
                    <line x1="16" y1="25" x2="10" y2="34" stroke="#00ff88" stroke-width="1.5" opacity="0.7"/>
                    <line x1="16" y1="25" x2="22" y2="34" stroke="#00ff88" stroke-width="1.5" opacity="0.7"/>
                    <line x1="36" y1="25" x2="30" y2="34" stroke="#00ff88" stroke-width="1.5" opacity="0.7"/>
                    <line x1="36" y1="25" x2="42" y2="34" stroke="#00ff88" stroke-width="1.5" opacity="0.7"/>
                    
                    <!-- Abstract code brackets -->
                    <path d="M4 14 L8 14 L8 34 L4 34" stroke="#00d4ff" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.6"/>
                    <path d="M48 14 L44 14 L44 34 L48 34" stroke="#00d4ff" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.6"/>
                </svg>
                CS Match
            </a>
            <nav class="main-nav">
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/library">Resources</a></li>
                    <li><a href="/request">Submit</a></li>
                </ul>
            </nav>
            <div class="header-actions">
                <button class="btn btn-outline login-btn">Log In</button>
                <button class="mobile-menu-btn">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Mobile Menu -->
    <div class="mobile-menu">
        <button class="close-btn">
            <i class="fas fa-times"></i>
        </button>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/library">Resources</a></li>
            <li><a href="/request">Submit</a></li>
        </ul>
    </div>

    <div class="container">
        <div class="page-title">
            <h1>CS Match Resource Library</h1>
            <p>Find the perfect match for your computer science teaching needs</p>
        </div>

        <div class="filters">
            <h3>Filter Resources</h3>
            <div class="filter-row">
                <div class="filter-group">
                    <label for="searchInput">Search Resources</label>
                    <input type="text" id="searchInput" placeholder="Search by name or description...">
                </div>
                
                <div class="filter-group">
                    <label class="filter-label-with-indicator">
                        <span class="filter-label-indicator resource-type">⚫</span>
                        Resource Type
                    </label>
                    <div id="resourceTypeAutocomplete" class="autocomplete-container"></div>
                </div>

                <div class="filter-group">
                    <label for="priceFilter" class="filter-label-with-indicator">
                        <span class="filter-label-indicator cost">🟢</span>
                        Cost
                    </label>
                    <select id="priceFilter">
                        <option value="">All Prices</option>
                        <option value="Free">Free</option>
                        <option value="Paid">Paid</option>
                    </select>
                </div>
            </div>

            <div class="filter-row">
                <div class="filter-group">
                    <label class="filter-label-with-indicator">
                        <span class="filter-label-indicator grade-level">🔵</span>
                        Grade Levels
                    </label>
                    <div id="gradeLevelAutocomplete" class="autocomplete-container"></div>
                </div>

                <div class="filter-group">
                    <label class="filter-label-with-indicator">
                        <span class="filter-label-indicator language">🟠</span>
                        Languages/Tools
                    </label>
                    <div id="languageAutocomplete" class="autocomplete-container"></div>
                </div>
                
                <div class="filter-group">
                    <label class="filter-label-with-indicator">
                        <span class="filter-label-indicator standards">🟣</span>
                        Standards Alignment
                    </label>
                    <div id="standardsAutocomplete" class="autocomplete-container"></div>
                </div>
                <div class="filter-group">
    <label class="filter-label-with-indicator">
        <span class="filter-label-indicator topic">⭕</span>
        Topic
    </label>
    <div id="topicAutocomplete" class="autocomplete-container"></div>
</div>
            </div>

            <div class="filter-row">
                <div class="filter-group">
                    <label for="sortBy">Sort By</label>
                    <select id="sortBy">
                        <option value="name-asc">Name (A-Z)</option>
                        <option value="name-desc">Name (Z-A)</option>
                        <option value="rating-desc">Rating (High to Low)</option>
                        <option value="rating-asc">Rating (Low to High)</option>
                    </select>
                </div>
            </div>

            <button class="clear-filters" onclick="clearAllFilters()">Clear All Filters</button>
        </div>

        <div class="results-count" id="resultsCount">
            <% if (Requests && Requests.length > 0) { %>
                <% const approvedCount = Requests.filter(request => request.isApproved).length; %>
                Showing <%= approvedCount %> approved resource<%= approvedCount !== 1 ? 's' : '' %>
            <% } else { %>
                No resources available
            <% } %>
        </div>

        <div class="resources-grid" id="resourcesGrid">
            <% if (Requests && Requests.length > 0) { %>
                <% Requests.filter(request => request.isApproved).forEach(request => { %>
                    <% 
                        // Get rating data for this request (assuming it's passed from server)
                        const ratingData = request.ratingData || { averageRating: 0, reviewCount: 0 };
                        const averageRating = ratingData.averageRating || 0;
                        const reviewCount = ratingData.reviewCount || 0;
                    %>
                    <div class="resource-card" data-resource='<%- JSON.stringify(request) %>' data-rating="<%= averageRating %>" data-review-count="<%= reviewCount %>">
                        <h3><%= request.ProductName %></h3>
                        
                        <!-- Rating Display - Server Side Rendered -->
                        <div class="rating-display">
                            <% if (reviewCount > 0) { %>
                                <div class="rating-stars">
                                    <% for (let i = 1; i <= 5; i++) { %>
                                        <span class="rating-star <%= i <= Math.round(averageRating) ? '' : 'empty' %>">★</span>
                                    <% } %>
                                </div>
                                <span class="rating-text">
                                    <%= averageRating.toFixed(1) %> (<%= reviewCount %> review<%= reviewCount !== 1 ? 's' : '' %>)
                                </span>
                            <% } else { %>
                                <span class="no-rating">No reviews yet</span>
                            <% } %>
                        </div>
                        
                        <p class="description"><%= request.Description %></p>
                        
<div class="product-topic">
    <span class="topic-label">Topic:</span>
    <span class="topic-value"><%= request.Topic %></span>
</div>

                        <div class="resource-meta">
                            <span class="meta-tag"><%= request.ProductType %></span>
                            <span class="meta-tag"><%= request.GradeLevel %></span>
                            <span class="price-tag"><%= request.Price %></span>
                        </div>
                        
                        <% if (request.SupportedLanguages) { %>
                            <div class="resource-meta">
                                <% request.SupportedLanguages.split(',').forEach(lang => { %>
                                    <span class="meta-tag"><%= lang.trim() %></span>
                                <% }) %>
                            </div>
                        <% } %>

                        <% if (request.StandardAlignment) { %>
                            <div class="standard-alignment">
                                <strong>Standards:</strong> <%= request.StandardAlignment %>
                            </div>
                        <% } %>

                        <div class="card-actions">
                            <a href="/indy/<%= request._id %>" class="btn btn-primary">Learn More</a>
                            <a href="<%= request.Website %>" target="_blank" class="btn btn-outline">Visit Website</a>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>

        <div class="no-results" id="noResults">
            <h3>No resources found</h3>
            <p>Try adjusting your filters to see more results.</p>
        </div>
    </div>

        <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-about">
                    <a href="#" class="footer-logo">
    CS Match
</a>

                    <p>Our mission is to empower computer science educators with high-quality, vetted resources to enhance teaching and learning experiences.</p>
                   <p>Contact us: 📧 shilpa.agrawal@compscihigh.org</p>
            </div>
            <div class="footer-bottom">
<p>© 2025 CS Match. All rights reserved.</p>
                <p>Made with ❤️ for CS educators worldwide</p>
            </div>
        </div>
    </footer>

    <!-- Login Modal -->
    <div class="modal" id="login-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Log In</h3>
                <button class="modal-close">&times;</button>
            </div>
            <form id="login-form">
                <div class="form-group">
                    <label for="username" class="form-label">Username</label>
                    <input type="text" id="username" name="username" class="form-input" required>
                </div>
                <div class="form-group">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" id="password" name="password" class="form-input" required>
                </div>
                <div class="form-footer">
                    <button type="submit" class="btn">Log In</button>
                </div>
                <div id="error-message" class="error-message"></div>
            </form>
        </div>
    </div>

</body>
</html>