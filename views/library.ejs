<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CS Match - Resource Library</title>
   <link rel="stylesheet" href="library.css" />
  <script src="library.js" defer></script>
</head>
<body>
    <header>
          <div class="container header-container">
             <a href="/" class="logo">
  <svg viewBox="0 0 52 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Binary tree structure representing CS algorithms -->
    <circle cx="26" cy="8" r="3" fill="#00d4ff" opacity="0.9">
      <animate attributeName="opacity" values="0.6;1;0.6" dur="3s" repeatCount="indefinite"/>
    </circle>
    
    <!-- Left branch -->
    <line x1="26" y1="11" x2="16" y2="20" stroke="#7c4dff" stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="16" cy="22" r="2.5" fill="#7c4dff"/>
    
    <!-- Right branch -->
    <line x1="26" y1="11" x2="36" y2="20" stroke="#7c4dff" stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="36" cy="22" r="2.5" fill="#7c4dff"/>
    
    <!-- Connection paths showing matching -->
    <path d="M16 25 Q26 30 36 25" stroke="#ff6b9d" stroke-width="2" fill="none" stroke-linecap="round">
      <animate attributeName="stroke-dasharray" values="0 20;20 0;0 20" dur="4s" repeatCount="indefinite"/>
    </path>
    
    <!-- Lower nodes representing successful matches -->
    <circle cx="10" cy="36" r="2" fill="#00ff88">
      <animate attributeName="r" values="1.5;2.5;1.5" dur="2.5s" repeatCount="indefinite"/>
    </circle>
    <circle cx="22" cy="36" r="2" fill="#00ff88">
      <animate attributeName="r" values="1.5;2.5;1.5" dur="2.5s" repeatCount="indefinite" begin="0.5s"/>
    </circle>
    <circle cx="30" cy="36" r="2" fill="#00ff88">
      <animate attributeName="r" values="1.5;2.5;1.5" dur="2.5s" repeatCount="indefinite" begin="1s"/>
    </circle>
    <circle cx="42" cy="36" r="2" fill="#00ff88">
      <animate attributeName="r" values="1.5;2.5;1.5" dur="2.5s" repeatCount="indefinite" begin="1.5s"/>
    </circle>
    
    <!-- Connecting lines to matches -->
    <line x1="16" y1="25" x2="10" y2="34" stroke="#00ff88" stroke-width="1.5" opacity="0.7"/>
    <line x1="16" y1="25" x2="22" y2="34" stroke="#00ff88" stroke-width="1.5" opacity="0.7"/>
    <line x1="36" y1="25" x2="30" y2="34" stroke="#00ff88" stroke-width="1.5" opacity="0.7"/>
    <line x1="36" y1="25" x2="42" y2="34" stroke="#00ff88" stroke-width="1.5" opacity="0.7"/>
    
    <!-- Abstract code brackets -->
    <path d="M4 14 L8 14 L8 34 L4 34" stroke="#00d4ff" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.6"/>
    <path d="M48 14 L44 14 L44 34 L48 34" stroke="#00d4ff" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.6"/>
  </svg>
  CS Match
</a>
            <nav class="main-nav">
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/library">Resources</a></li>
                    <li><a href="/request">Submit</a></li>
                </ul>
            </nav>
            <div class="header-actions">
                <button class="btn btn-outline login-btn">Log In At The Home Page</button>
                <button class="mobile-menu-btn">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </div>
        </header>

    <!-- Mobile Menu -->
    <div class="mobile-menu">
        <button class="close-btn">
            <i class="fas fa-times"></i>
        </button>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/library">Resources</a></li>
            <li><a href="/request">Submit</a></li>
        </ul>
    </div>

    <div class="container">
        <div class="page-title">
<h1>CS Match Resource Library</h1>
<p>Find the perfect match for your computer science teaching needs</p>
        </div>

        <div class="filters">
            <h3>Filter Resources</h3>
            <div class="filter-row">
                <div class="filter-group">
                    <label for="searchInput">Search Resources</label>
                    <input type="text" id="searchInput" placeholder="Search by name or description...">
                </div>
                
              

                <div class="filter-group">
                    <label for="priceFilter">Price Model</label>
                    <select id="priceFilter">
                        <option value="">All Prices</option>
                        <option value="Free">Free</option>
                        <option value="Paid">Paid</option>
                        <option value="Freemium">Freemium</option>
                        <option value="Subscription">Subscription</option>
                    </select>
                </div>
            </div>

            <div class="filter-row">
                <div class="filter-group">
                    <label>Grade Levels</label>
                    <div class="checkbox-group">
                        <div class="checkbox-item">
                            <input type="checkbox" id="gradeK5" value="K-5">
                            <label for="gradeK5">K-5</label>
                        </div>
                        <div class="checkbox-item">
                            <input type="checkbox" id="grade68" value="6-8">
                            <label for="grade68">6-8</label>
                        </div>
                        <div class="checkbox-item">
                            <input type="checkbox" id="grade912" value="9-12">
                            <label for="grade912">9-12</label>
                        </div>
                        <div class="checkbox-item">
                            <input type="checkbox" id="gradeHigherEd" value="Higher Ed">
                            <label for="gradeHigherEd">Higher Ed</label>
                        </div>
                    </div>
                </div>

                <div class="filter-group">
                    <label>Supported Languages/Tools</label>
                    <div class="checkbox-group">
                        <div class="checkbox-item">
                            <input type="checkbox" id="langScratch" value="Scratch">
                            <label for="langScratch">Scratch</label>
                        </div>
                        <div class="checkbox-item">
                            <input type="checkbox" id="langPython" value="Python">
                            <label for="langPython">Python</label>
                        </div>
                        <div class="checkbox-item">
                            <input type="checkbox" id="langJavaScript" value="JavaScript">
                            <label for="langJavaScript">JavaScript</label>
                        </div>
                        <div class="checkbox-item">
                            <input type="checkbox" id="langJava" value="Java">
                            <label for="langJava">Java</label>
                        </div>
                        <div class="checkbox-item">
                            <input type="checkbox" id="langBlockBased" value="Block-based">
                            <label for="langBlockBased">Block-based</label>
                        </div>
                        <div class="checkbox-item">
                            <input type="checkbox" id="langHTML" value="HTML/CSS">
                            <label for="langHTML">HTML/CSS</label>
                        </div>
                    </div>
                </div>
            </div>

            <button class="clear-filters" onclick="clearAllFilters()">Clear All Filters</button>
        </div>

        <div class="results-count" id="resultsCount">
            <% if (Requests && Requests.length > 0) { %>
                <% const approvedCount = Requests.filter(request => request.isApproved).length; %>
                Showing <%= approvedCount %> approved resource<%= approvedCount !== 1 ? 's' : '' %>
            <% } else { %>
                No resources available
            <% } %>
        </div>

        <div class="resources-grid" id="resourcesGrid">
            <% if (Requests && Requests.length > 0) { %>
                <% Requests.filter(request => request.isApproved).forEach(request => { %>
                    <div class="resource-card" data-resource='<%- JSON.stringify(request) %>'>
                        <h3><%= request.ProductName %></h3>
                        <a href="<%= request.Website %>" target="_blank" class="website"><%= request.Website %></a>
                        <p class="description"><%= request.Description %></p>
                        
                        <div class="resource-meta">
                            <span class="meta-tag"><%= request.ProductType %></span>
                            <span class="meta-tag"><%= request.GradeLevel %></span>
                            <span class="price-tag"><%= request.Price %></span>
                        </div>
                        
                        <% if (request.SupportedLanguages) { %>
                            <div class="resource-meta">
                                <% request.SupportedLanguages.split(',').forEach(lang => { %>
                                    <span class="meta-tag"><%= lang.trim() %></span>
                                <% }) %>
                            </div>
                        <% } %>

                        <% if (request.StandardAlignment) { %>
                            <div class="standard-alignment">
                                <strong>Standards:</strong> <%= request.StandardAlignment %>
                            </div>
                        <% } %>

                        <div class="card-actions">
                            <a href="/indy/<%= request._id %>" class="btn btn-primary">Learn More</a>
                            <a href="<%= request.Website %>" target="_blank" class="btn btn-outline">Visit Website</a>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>

        <div class="no-results" id="noResults" style="display: none;">
            <h3>No resources found</h3>
            <p>Try adjusting your filters to see more results.</p>
        </div>
    </div>

</body>
</html>